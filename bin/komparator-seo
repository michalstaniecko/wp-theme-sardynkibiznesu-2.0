#!/usr/bin/env php
<?php
/**
 * Komparator SEO 2.0 ↔ 3.0 i porównanie treści.
 *
 * Porównuje wyrenderowane strony dwóch adresów bazowych (A = 2.0, B = 3.0)
 * i kończy się kodem 1, gdy znajdzie różnicę blokującą przełączenie.
 * Instrukcja: docs/komparator-seo.md
 */

declare(strict_types=1);

const EXIT_OK = 0;
const EXIT_BLOCKING = 1;
const EXIT_USAGE = 2;

/** Content area of a post or page: `.entry-content` in 2.0, `core/post-content` in 3.0. */
const CONTENT_SELECTOR = '.entry-content, .wp-block-post-content';

/** Przycisk in 2.0: sb_button, cmsmasters_button, acf/sb-button. In 3.0 every record is `.wp-block-button`. */
const LEGACY_BUTTON_SELECTOR = 'a.button-outline, a.cmsmasters_button, .sb-block-button';
const BUTTON_SELECTOR = '.wp-block-button';

/** Notka in 2.0: cmsmasters_notice. In 3.0: core/group with the "neutral" style. */
const LEGACY_NOTKA_SELECTOR = '.cmsmasters_notice';
const NOTKA_SELECTOR = '.wp-block-group.is-style-neutral';

/**
 * Formularz zapisu that 2.0 appends to every article through a `the_content` filter
 * (ihumbak-newsletter-form). 3.0 has it in the template instead, so it is not counted.
 */
const NEWSLETTER_FILTER_FORM_SELECTOR = 'form.getresponse-form';

if (realpath($_SERVER['SCRIPT_FILENAME'] ?? '') === __FILE__) {
    main($argv);
}

function main(array $argv): void
{
    if (PHP_VERSION_ID < 80400 || !class_exists(\Dom\HTMLDocument::class) || !function_exists('curl_init')) {
        fwrite(STDERR, "Wymagane PHP 8.4+ z rozszerzeniami dom i curl.\n");
        exit(EXIT_USAGE);
    }
    $opt = parse_options($argv);
    $run = new Run($opt);
    $run->execute();
    $report = render_report($run);
    file_put_contents($opt['report'], $report);
    $blocking = count($run->blocking);
    echo ($blocking ? "Wynik: BLOKUJE ($blocking różnic blokujących)" : 'Wynik: OK') . "\n";
    echo 'Do przeglądu: ' . count($run->review) . "\n";
    echo "Raport: {$opt['report']}\n";
    exit($blocking ? EXIT_BLOCKING : EXIT_OK);
}

function usage(): string
{
    return <<<TXT
Użycie: bin/komparator-seo --a=URL_2.0 --b=URL_3.0 [opcje]

  --a=URL            adres bazowy 2.0 (wzorzec), np. https://sardynkibiznesu.pl
  --b=URL            adres bazowy 3.0 (sprawdzany), np. https://staging.sardynkibiznesu.pl
  --auth-a=U:P       Basic Auth dla A
  --auth-b=U:P       Basic Auth dla B
  --old-slugs=PLIK   plik ze starymi slugami (jedna ścieżka na linię, # = komentarz)
  --search=FRAZA     fraza do sprawdzenia wyszukiwarki ?s= (domyślnie: biznes)
  --max-pages=N      najwyższy numer /page/N/ do sprawdzenia (domyślnie: do pierwszego nie-200 na A, max 50)
  --limit=N          sprawdź tylko N pierwszych URL-i z sitemap (do prób)
  --delay=MS         przerwa między żądaniami w ms (domyślnie 300)
  --report=PLIK      ścieżka raportu Markdown (domyślnie komparator-seo-RRRRMMDD-GGMM.md)

Kod wyjścia: 0 = brak różnic blokujących, 1 = są różnice blokujące, 2 = błąd użycia.

TXT;
}

function parse_options(array $argv): array
{
    $opt = [
        'a' => null, 'b' => null, 'auth-a' => null, 'auth-b' => null, 'old-slugs' => null,
        'search' => 'biznes', 'max-pages' => null, 'limit' => null, 'delay' => '300',
        'report' => 'komparator-seo-' . date('Ymd-Hi') . '.md',
    ];
    foreach (array_slice($argv, 1) as $arg) {
        if ($arg === '--help' || $arg === '-h') {
            echo usage();
            exit(EXIT_OK);
        }
        if (!preg_match('/^--([a-z-]+)=(.*)$/s', $arg, $m) || !array_key_exists($m[1], $opt)) {
            fwrite(STDERR, "Nieznana opcja: $arg\n\n" . usage());
            exit(EXIT_USAGE);
        }
        $opt[$m[1]] = $m[2];
    }
    if (!$opt['a'] || !$opt['b']) {
        fwrite(STDERR, "Podaj --a i --b.\n\n" . usage());
        exit(EXIT_USAGE);
    }
    $opt['a'] = rtrim($opt['a'], '/');
    $opt['b'] = rtrim($opt['b'], '/');
    $opt['delay'] = max(0, (int) $opt['delay']);
    return $opt;
}

/* ------------------------------------------------------------------ HTTP */

final class Http
{
    private float $last = 0.0;

    public function __construct(private int $delayMs, private ?string $auth)
    {
    }

    /** One request without following redirects. */
    public function get(string $url): array
    {
        $wait = $this->delayMs / 1000 - (microtime(true) - $this->last);
        if ($wait > 0) {
            usleep((int) ($wait * 1e6));
        }
        $headers = [];
        $ch = curl_init($url);
        curl_setopt_array($ch, [
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_FOLLOWLOCATION => false,
            CURLOPT_TIMEOUT => 60,
            CURLOPT_CONNECTTIMEOUT => 15,
            CURLOPT_USERAGENT => 'SB-Komparator-SEO/1.0',
            CURLOPT_ENCODING => '',
            CURLOPT_HEADERFUNCTION => function ($ch, $line) use (&$headers) {
                if (str_contains($line, ':')) {
                    [$k, $v] = explode(':', $line, 2);
                    $headers[strtolower(trim($k))] = trim($v);
                }
                return strlen($line);
            },
        ]);
        if ($this->auth) {
            curl_setopt($ch, CURLOPT_USERPWD, $this->auth);
        }
        $body = curl_exec($ch);
        $status = (int) curl_getinfo($ch, CURLINFO_RESPONSE_CODE);
        $error = $body === false ? curl_error($ch) : null;
        $this->last = microtime(true);
        return ['status' => $error ? 0 : $status, 'headers' => $headers, 'body' => $body === false ? '' : $body, 'error' => $error];
    }

    /** Follows redirects manually and records the chain. */
    public function fetch(string $url): array
    {
        $chain = [];
        for ($i = 0; $i < 10; $i++) {
            $r = $this->get($url);
            $chain[] = ['url' => $url, 'status' => $r['status']];
            $loc = $r['headers']['location'] ?? null;
            if ($r['status'] >= 300 && $r['status'] < 400 && $loc) {
                $url = resolve_url($url, $loc);
                continue;
            }
            return $r + ['chain' => $chain, 'final' => $url];
        }
        return $r + ['chain' => $chain, 'final' => $url, 'error' => 'za dużo przekierowań'];
    }
}

function resolve_url(string $base, string $rel): string
{
    if (preg_match('#^https?://#i', $rel)) {
        return $rel;
    }
    $p = parse_url($base);
    $origin = $p['scheme'] . '://' . $p['host'] . (isset($p['port']) ? ':' . $p['port'] : '');
    if (str_starts_with($rel, '//')) {
        return $p['scheme'] . ':' . $rel;
    }
    if (str_starts_with($rel, '/')) {
        return $origin . $rel;
    }
    $dir = preg_replace('#/[^/]*$#', '/', $p['path'] ?? '/');
    return $origin . $dir . $rel;
}

/** Path + query of a URL, used as the key shared by A and B. */
function url_key(string $url): string
{
    $p = parse_url($url);
    return ($p['path'] ?? '/') . (isset($p['query']) ? '?' . $p['query'] : '');
}

/* --------------------------------------------------------------- the run */

final class Run
{
    public array $opt;
    public Http $httpA;
    public Http $httpB;
    /** @var array<string,string> path => kind */
    public array $urls = [];
    /** @var list<array{url:string,check:string,a:string,b:string}> */
    public array $blocking = [];
    public array $review = [];
    public array $notes = [];
    public int $contentChecked = 0;
    /** @var array<string,array<string,array{count:int,url:string}>> style => signature => first URL */
    public array $buttonSignatures = [];

    public function __construct(array $opt)
    {
        $this->opt = $opt;
        $this->httpA = new Http($opt['delay'], $opt['auth-a']);
        $this->httpB = new Http($opt['delay'], $opt['auth-b']);
    }

    public function execute(): void
    {
        $this->collectUrls();
        $i = 0;
        $total = count($this->urls);
        foreach ($this->urls as $path => $kind) {
            fwrite(STDERR, sprintf("[%d/%d] %s\n", ++$i, $total, $path));
            $this->compareUrl($path, $kind);
        }
        $this->compareButtonSignatures();
    }

    private function collectUrls(): void
    {
        $paths = [];
        foreach (['a' => $this->httpA, 'b' => $this->httpB] as $side => $http) {
            $base = $this->opt[$side];
            $found = sitemap_urls($http, $base . '/sitemap_index.xml');
            if ($found === null) {
                $this->notes[] = "Nie udało się pobrać sitemap z {$base}/sitemap_index.xml.";
                continue;
            }
            foreach ($found as $u) {
                $paths[url_key($u)] ??= 'sitemap';
            }
        }
        // Published content that is not in the sitemap (e.g. noindex), from the 2.0 REST API.
        $published = rest_links($this->httpA, $this->opt['a']);
        if ($published === null) {
            $this->notes[] = 'REST API 2.0 niedostępne: treści spoza sitemap nie zostały sprawdzone.';
        }
        foreach ($published ?? [] as $u) {
            $paths[url_key($u)] ??= 'treść spoza sitemap';
        }
        if ($this->opt['limit'] !== null) {
            $paths = array_slice($paths, 0, (int) $this->opt['limit'], true);
        }
        foreach ($this->specialUrls() as $path => $kind) {
            $paths[$path] = $kind;
        }
        $this->urls = $paths;
    }

    /** Special list: /feed/, /page/N/, 404, ?s=, old slugs. */
    private function specialUrls(): array
    {
        $out = ['/feed/' => 'feed'];
        $max = $this->opt['max-pages'] !== null ? (int) $this->opt['max-pages'] : 50;
        for ($n = 2; $n <= $max; $n++) {
            // Without --max-pages, stop at the first page 2.0 does not serve.
            if ($this->opt['max-pages'] === null && $this->httpA->get($this->opt['a'] . "/page/$n/")['status'] !== 200) {
                break;
            }
            $out["/page/$n/"] = 'paginacja';
        }
        $out['/komparator-seo-sprawdzenie-404/'] = '404';
        $out['/?s=' . rawurlencode($this->opt['search'])] = 'wyszukiwarka';
        if ($this->opt['old-slugs'] !== null) {
            $lines = @file($this->opt['old-slugs'], FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES);
            if ($lines === false) {
                fwrite(STDERR, "Nie można odczytać pliku {$this->opt['old-slugs']}.\n");
                exit(EXIT_USAGE);
            }
            foreach ($lines as $line) {
                $line = trim($line);
                if ($line !== '' && $line[0] !== '#') {
                    $out[url_key($line)] = 'stary slug';
                }
            }
        }
        return $out;
    }

    private function compareUrl(string $path, string $kind): void
    {
        $a = page_facts($this->httpA->fetch($this->opt['a'] . $path), $this->opt['a'], true);
        $b = page_facts($this->httpB->fetch($this->opt['b'] . $path), $this->opt['b'], false);
        if ($kind === 'feed') {
            // 2.0 returns 500 here; 3.0 must return 200.
            if ($b['chain'] !== '200') {
                $this->block($path, '/feed/ zwraca 200', $a['chain'], $b['chain']);
            }
            return;
        }
        if ($kind === 'paginacja') {
            // In 3.0 the post list moves to /blog/ (Redirection rule ^/page/(\d+)/?$ → /blog/page/$1/).
            $expected = '301 → 200 {BASE}/blog' . $path;
            if ($b['chain'] !== $expected) {
                $this->block($path, 'przekierowanie na /blog/page/N/', $a['chain'], $b['chain']);
            }
            return;
        }
        $this->compareSeo($path, $a, $b);
        if (in_array($kind, ['sitemap', 'treść spoza sitemap'], true) && $a['status'] === 200 && ($a['content'] ?? null) !== null) {
            $this->compareContent($path, $a['content'], $b['content'] ?? null);
        }
    }

    /** Published content: rendered the_content of 2.0 vs 3.0. */
    private function compareContent(string $path, array $a, ?array $b): void
    {
        $this->contentChecked++;
        if ($b === null) {
            $this->block($path, 'obszar treści', 'jest', 'nie znaleziono (' . CONTENT_SELECTOR . ')');
            return;
        }
        if ($b['shortcodes']) {
            $this->block($path, "surowe shortcode'y", implode(', ', $a['shortcodes']), implode(', ', $b['shortcodes']));
        }
        if ($b['nestedHeadings'] > 0) {
            $this->block($path, 'jeden nagłówek zamiast zagnieżdżonego', '', 'zagnieżdżone: ' . $b['nestedHeadings']);
        }
        $aButtons = $a['buttonsLegacy'] + count($a['buttons']);
        if ($aButtons !== count($b['buttons']) || $b['buttonsLegacy'] > 0) {
            $this->block($path, 'Przycisk', (string) $aButtons, count($b['buttons']) . ($b['buttonsLegacy'] ? " (stary markup: {$b['buttonsLegacy']})" : ''));
        }
        foreach ($b['buttons'] as $btn) {
            $this->buttonSignatures[$btn['style']][$btn['signature']] ??= ['count' => 0, 'url' => $path];
            $this->buttonSignatures[$btn['style']][$btn['signature']]['count']++;
        }
        $aNotices = $a['notices'] + $a['noticesLegacy'];
        if ($aNotices !== $b['notices'] || $b['noticesLegacy'] > 0) {
            $this->block($path, 'Notka', (string) $aNotices, $b['notices'] . ($b['noticesLegacy'] ? " (stary markup: {$b['noticesLegacy']})" : ''));
        }
        if ($a['forms'] !== $b['workingForms'] || $b['forms'] !== $b['workingForms']) {
            $this->block($path, 'Formularz zapisu', (string) $a['forms'], "{$b['workingForms']} działających z {$b['forms']}");
        }
    }

    /** Przycisk must give identical markup whichever way it was recorded: one signature per style. */
    private function compareButtonSignatures(): void
    {
        foreach ($this->buttonSignatures as $style => $signatures) {
            if (count($signatures) < 2) {
                continue;
            }
            uasort($signatures, fn($x, $y) => $y['count'] <=> $x['count']);
            $dominant = array_key_first($signatures);
            foreach (array_slice($signatures, 1, null, true) as $sig => $info) {
                $this->block($info['url'], "Przycisk: identyczny markup ($style)", $dominant, $sig);
            }
        }
    }

    private function block(string $url, string $check, string $a, string $b): void
    {
        $this->blocking[] = compact('url', 'check', 'a', 'b');
    }

    private function toReview(string $url, string $check, string $a, string $b): void
    {
        $this->review[] = compact('url', 'check', 'a', 'b');
    }

    private function compareSeo(string $path, array $a, array $b): void
    {
        if ($a['chain'] !== $b['chain']) {
            $this->block($path, 'status / przekierowania', $a['chain'], $b['chain']);
        }
        if (!$a['html'] || !$b['html']) {
            return;
        }
        foreach (['title', 'canonical', 'robots'] as $key) {
            if ($a[$key] !== $b[$key]) {
                $this->block($path, $key, (string) $a[$key], (string) $b[$key]);
            }
        }
        if ($a['description'] !== $b['description']) {
            $this->toReview($path, 'description', (string) $a['description'], (string) $b['description']);
        }
        if ($b['h1'] !== 1) {
            $this->block($path, 'liczba H1', (string) $a['h1'], (string) $b['h1']);
        }
        if ($a['jsonldTypes'] !== $b['jsonldTypes']) {
            $this->toReview($path, 'JSON-LD typy', implode(', ', $a['jsonldTypes']), implode(', ', $b['jsonldTypes']));
        }
        if ($b['graphNonObjects'] > 0) {
            $this->block($path, '@graph tylko obiekty', 'nie-obiekty: ' . $a['graphNonObjects'], 'nie-obiekty: ' . $b['graphNonObjects']);
        }
        if ($a['anchors'] !== null) {
            $missing = array_values(array_diff($a['anchors'], $b['anchors'] ?? []));
            $added = array_values(array_diff($b['anchors'] ?? [], $a['anchors']));
            $addedText = $added ? 'nowe w 3.0: ' . implode(', ', $added) : '';
            if ($missing) {
                $this->block($path, 'Kotwice', 'brak w 3.0: ' . implode(', ', $missing), $addedText);
            } elseif ($added) {
                $this->toReview($path, 'Kotwice', '', $addedText);
            }
        }
    }
}

/* ------------------------------------------------------------- sitemaps */

/** @return list<string>|null */
function sitemap_urls(Http $http, string $url, int $depth = 0): ?array
{
    $r = $http->fetch($url);
    if ($r['status'] !== 200 || $depth > 2) {
        return null;
    }
    $doc = new DOMDocument();
    if (!@$doc->loadXML($r['body'])) {
        return null;
    }
    // Only <loc> in the sitemap namespace: Yoast also lists images as <image:loc>.
    $ns = 'http://www.sitemaps.org/schemas/sitemap/0.9';
    $out = [];
    foreach ($doc->getElementsByTagNameNS($ns, 'sitemap') as $sm) {
        foreach ($sm->getElementsByTagNameNS($ns, 'loc') as $loc) {
            $out = array_merge($out, sitemap_urls($http, trim($loc->textContent), $depth + 1) ?? []);
        }
    }
    foreach ($doc->getElementsByTagNameNS($ns, 'url') as $u) {
        foreach ($u->getElementsByTagNameNS($ns, 'loc') as $loc) {
            $out[] = trim($loc->textContent);
        }
    }
    return $out;
}

/** @return list<string>|null links of all published posts and pages */
function rest_links(Http $http, string $base): ?array
{
    $out = [];
    foreach (['posts', 'pages'] as $type) {
        for ($page = 1, $total = 1; $page <= $total; $page++) {
            $r = $http->get("$base/wp-json/wp/v2/$type?per_page=100&page=$page&_fields=link");
            $items = json_decode($r['body'], true);
            if ($r['status'] !== 200 || !is_array($items)) {
                return null;
            }
            $total = (int) ($r['headers']['x-wp-totalpages'] ?? 1);
            foreach ($items as $item) {
                if (isset($item['link'])) {
                    $out[] = $item['link'];
                }
            }
        }
    }
    return $out;
}

/* ---------------------------------------------------------------- facts */

/** Replaces the site's own origin with a neutral marker so A and B values compare. */
function neutral(?string $value, string $base): ?string
{
    if ($value === null) {
        return null;
    }
    $origin = preg_replace('#^(https?://[^/]+).*$#', '$1', $base);
    return str_replace($origin, '{BASE}', $value);
}

function page_facts(array $r, string $base, bool $emulateV1Anchors): array
{
    $chain = implode(' → ', array_map(
        fn($c) => $c['status'] . ' ' . neutral($c['url'], $base),
        array_slice($r['chain'], 1)
    ));
    $f = [
        'status' => $r['status'],
        'chain' => $r['chain'][0]['status'] . ($chain !== '' ? ' → ' . $chain : '') . ($r['error'] ? ' (' . $r['error'] . ')' : ''),
        'final' => $r['final'],
        'html' => false,
    ];
    $type = $r['headers']['content-type'] ?? '';
    if ($r['body'] === '' || !str_contains($type, 'html')) {
        return $f;
    }
    $doc = \Dom\HTMLDocument::createFromString($r['body'], LIBXML_NOERROR, 'UTF-8');
    $attr = fn(string $sel, string $name) => $doc->querySelector($sel)?->getAttribute($name);
    $f['html'] = true;
    $f['title'] = trim($doc->querySelector('title')?->textContent ?? '');
    $f['description'] = $attr('meta[name="description"]', 'content');
    $f['canonical'] = neutral($attr('link[rel="canonical"]', 'href'), $base);
    $f['robots'] = $attr('meta[name="robots"]', 'content');
    $f['h1'] = $doc->querySelectorAll('h1')->length;
    [$f['jsonldTypes'], $f['graphNonObjects']] = jsonld_facts($doc);
    if ($emulateV1Anchors) {
        emulate_v1_anchors($doc);
    }
    $content = $doc->querySelector(CONTENT_SELECTOR);
    $f['anchors'] = $content ? heading_anchors($content) : null;
    $f['content'] = $content ? content_facts($content, $r['body']) : null;
    return $f;
}

/** Facts about content elements (Przycisk, Notka, Formularz zapisu) inside the content area. */
function content_facts(\Dom\Element $content, string $rawHtml): array
{
    $count = fn(string $sel) => $content->querySelectorAll($sel)->length;
    $buttons = [];
    foreach ($content->querySelectorAll(BUTTON_SELECTOR) as $btn) {
        $style = 'bez stylu';
        foreach (class_list($btn) as $c) {
            if (str_starts_with($c, 'is-style-')) {
                $style = $c;
            }
        }
        $buttons[] = ['style' => $style, 'signature' => markup_signature($btn)];
    }
    $forms = 0;
    $workingForms = 0;
    foreach ($content->querySelectorAll('form') as $form) {
        if (!$form->querySelector('input[type="email"]') || $form->matches(NEWSLETTER_FILTER_FORM_SELECTOR)) {
            continue;
        }
        $forms++;
        if (strtolower($form->getAttribute('method') ?? '') === 'post'
            && str_contains($form->getAttribute('action') ?? '', 'admin-post.php')) {
            $workingForms++;
        }
    }
    return [
        'shortcodes' => raw_shortcodes($content),
        'nestedHeadings' => preg_match_all('/<h[1-6]\b[^>]*>(?:\s|&nbsp;)*<h[1-6]\b/i', $rawHtml),
        'buttons' => $buttons,
        'buttonsLegacy' => $count(LEGACY_BUTTON_SELECTOR),
        'notices' => $count(NOTKA_SELECTOR),
        'noticesLegacy' => $count(LEGACY_NOTKA_SELECTOR),
        'forms' => $forms,
        'workingForms' => $workingForms,
    ];
}

/** @return list<string> */
function class_list(\Dom\Element $el): array
{
    return array_values(array_filter(preg_split('/\s+/', $el->getAttribute('class') ?? '')));
}

/**
 * Shape of an element subtree: tags and classes, without attribute values,
 * style variants (is-style-*) and colour/alignment classes (has-*).
 */
function markup_signature(\Dom\Element $el): string
{
    $classes = array_filter(class_list($el), fn($c) => !str_starts_with($c, 'is-style-') && !str_starts_with($c, 'has-'));
    sort($classes);
    $sig = strtolower($el->localName) . ($classes ? '.' . implode('.', $classes) : '');
    $children = [];
    for ($child = $el->firstElementChild; $child; $child = $child->nextElementSibling) {
        $children[] = markup_signature($child);
    }
    if (count($children) === 1) {
        $sig .= ' > ' . $children[0];
    } elseif ($children) {
        $sig .= ' > (' . implode(' + ', $children) . ')';
    }
    return $sig;
}

/** @return list<string> shortcode tags left as text, e.g. "[sb_button url=…]" */
function raw_shortcodes(\Dom\Element $content): array
{
    $copy = $content->cloneNode(true);
    foreach ($copy->querySelectorAll('script, style, code, pre, textarea') as $el) {
        $el->remove();
    }
    $known = 'sardynka|acf|caption|gallery|embed|audio|video|playlist';
    preg_match_all('/\[\/?(?:[a-z][a-z0-9]*(?:[_-][a-z0-9]+)+|' . $known . ')(?:\s[^\[\]]*)?\]/i', $copy->textContent, $m);
    return array_values(array_unique($m[0]));
}

/**
 * In 2.0 the v1 Kotwice are set in the browser by ihumbak-anchor.js, only when
 * the page has the old Spis treści. This repeats that script on the parsed page:
 * id = text with whitespace → "-", then everything outside [a-zA-Z0-9-] removed.
 */
function emulate_v1_anchors(\Dom\HTMLDocument $doc): void
{
    if (!$doc->querySelector('.ihumbak-anchor-menu-wrapper')) {
        return;
    }
    foreach ($doc->querySelectorAll('.ihumbak-anchor') as $el) {
        $el->setAttribute('id', v1_anchor_id($el->textContent));
    }
}

function v1_anchor_id(string $text): string
{
    // JavaScript \s: ASCII whitespace plus the Unicode space separators, NBSP and BOM.
    $id = preg_replace('/[\t\n\x{0B}\f\r \x{A0}\x{1680}\x{2000}-\x{200A}\x{2028}\x{2029}\x{202F}\x{205F}\x{3000}\x{FEFF}]/u', '-', $text);
    return preg_replace('/[^a-zA-Z0-9\-]/u', '', $id);
}

/** @return list<string> headings with an id, as "h2#id", in document order */
function heading_anchors(\Dom\Element $root): array
{
    $out = [];
    foreach ($root->querySelectorAll('h1[id], h2[id], h3[id], h4[id], h5[id], h6[id]') as $h) {
        $out[] = strtolower($h->localName) . '#' . $h->getAttribute('id');
    }
    return $out;
}

/** @return array{0:list<string>,1:int} sorted unique @type values and count of non-object @graph items */
function jsonld_facts(\Dom\HTMLDocument $doc): array
{
    $types = [];
    $nonObjects = 0;
    foreach ($doc->querySelectorAll('script[type="application/ld+json"]') as $script) {
        $data = json_decode($script->textContent, true);
        if (!is_array($data)) {
            continue;
        }
        $items = isset($data['@graph']) && is_array($data['@graph']) ? $data['@graph'] : (array_is_list($data) ? $data : [$data]);
        foreach ($items as $item) {
            if (!is_array($item) || array_is_list($item)) {
                $nonObjects++;
                continue;
            }
            foreach ((array) ($item['@type'] ?? []) as $t) {
                $types[] = (string) $t;
            }
        }
    }
    $types = array_values(array_unique($types));
    sort($types);
    return [$types, $nonObjects];
}

/* --------------------------------------------------------------- report */

function md_cell(string $s): string
{
    $s = str_replace(["\r", "\n", '|'], [' ', ' ', '\\|'], $s);
    return $s === '' ? '—' : (mb_strlen($s) > 200 ? mb_substr($s, 0, 197) . '…' : $s);
}

function md_table(array $rows): string
{
    if (!$rows) {
        return "Brak.\n";
    }
    $out = "| URL | Sprawdzenie | 2.0 (A) | 3.0 (B) |\n|---|---|---|---|\n";
    foreach ($rows as $r) {
        $out .= '| ' . md_cell($r['url']) . ' | ' . md_cell($r['check']) . ' | ' . md_cell($r['a']) . ' | ' . md_cell($r['b']) . " |\n";
    }
    return $out;
}

function render_report(Run $run): string
{
    $o = $run->opt;
    $blocking = count($run->blocking);
    $verdict = $blocking ? "**Wynik: BLOKUJE** — $blocking różnic blokujących przełączenie." : '**Wynik: OK** — brak różnic blokujących.';
    $out = "# Komparator SEO 2.0 ↔ 3.0\n\n";
    $out .= "- A (2.0): {$o['a']}\n- B (3.0): {$o['b']}\n- Data: " . date('Y-m-d H:i') . "\n";
    $out .= '- Sprawdzone URL-e: ' . count($run->urls) . "\n- Sprawdzone treści: {$run->contentChecked}\n\n";
    $out .= $verdict . "\n\n";
    $out .= "Blokują: status i przekierowania, `<title>`, canonical, robots, brakujące Kotwice, H1 ≠ 1 w 3.0, "
        . "`/feed/` ≠ 200, `@graph` z nie-obiektami, `/page/N/` bez przekierowania na `/blog/page/N/` oraz regresje treści "
        . "(surowe shortcode'y, zagnieżdżone nagłówki, Przycisk, Notka, Formularz zapisu). "
        . "Description, typy JSON-LD i nowe Kotwice są tylko do przeglądu. "
        . "Adres bazowy każdej strony jest zastąpiony przez `{BASE}`.\n\n";
    foreach ($run->notes as $n) {
        $out .= "> $n\n";
    }
    $summary = [];
    foreach (['blocking' => 0, 'review' => 1] as $list => $col) {
        foreach ($run->$list as $row) {
            $summary[$row['check']] ??= [0, 0];
            $summary[$row['check']][$col]++;
        }
    }
    if ($summary) {
        $out .= "\n## Podsumowanie\n\n| Sprawdzenie | Blokujące | Do przeglądu |\n|---|---|---|\n";
        foreach ($summary as $check => [$b, $r]) {
            $out .= '| ' . md_cell($check) . " | $b | $r |\n";
        }
    }
    $out .= "\n## Różnice blokujące\n\n" . md_table($run->blocking);
    $out .= "\n## Do przeglądu (nie blokują)\n\n" . md_table($run->review);
    $out .= "\n## Sprawdzone URL-e\n\n";
    foreach ($run->urls as $path => $kind) {
        $out .= "- `$path` ($kind)\n";
    }
    return $out;
}
