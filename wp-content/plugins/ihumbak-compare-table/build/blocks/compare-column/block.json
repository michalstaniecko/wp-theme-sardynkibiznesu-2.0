{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ihumbak/compare-column",
  "title": "Service column",
  "category": "widgets",
  "icon": "table-col-after",
  "description": "A compared service: name, price, image and a button.",
  "parent": [
    "ihumbak/compare-header"
  ],
  "textdomain": "ihumbak-compare-table",
  "attributes": {
    "name": {
      "type": "string",
      "default": ""
    },
    "price": {
      "type": "string",
      "default": ""
    },
    "priceNote": {
      "type": "string",
      "default": ""
    },
    "imageId": {
      "type": "number",
      "default": 0
    },
    "imageAlt": {
      "type": "string",
      "default": ""
    },
    "buttonText": {
      "type": "string",
      "default": ""
    },
    "buttonUrl": {
      "type": "string",
      "default": ""
    },
    "buttonNewTab": {
      "type": "boolean",
      "default": false
    },
    "buttonRel": {
      "type": "string",
      "default": ""
    }
  },
  "supports": {
    "html": false,
    "reusable": false,
    "customClassName": false,
    "lock": false
  },
  "editorScript": "file:./index.js"
}