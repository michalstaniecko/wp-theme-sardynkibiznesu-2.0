{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ihumbak/compare-section",
  "title": "Compare table section",
  "category": "widgets",
  "icon": "editor-insertmore",
  "description": "A collapsible group of feature rows.",
  "parent": [
    "ihumbak/compare-table"
  ],
  "textdomain": "ihumbak-compare-table",
  "attributes": {
    "title": {
      "type": "string",
      "default": ""
    },
    "defaultOpen": {
      "type": "boolean",
      "default": true
    }
  },
  "supports": {
    "html": false,
    "reusable": false,
    "customClassName": false
  },
  "editorScript": "file:./index.js"
}